generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

/// Platform-wide role. Store-level roles live on StoreMember.
enum PlatformRole {
  USER
  SUPER_ADMIN
}

/// Role of a user inside a single store (tenant).
enum StoreRole {
  STORE_OWNER
  STORE_ADMIN
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum InventoryReason {
  INITIAL
  RESTOCK
  CORRECTION
  DAMAGED
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
}

// ─────────────────────────────────────────────────────────────
// Auth (managed by Better Auth)
// ─────────────────────────────────────────────────────────────

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships StoreMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────

/// A store is a tenant. Every tenant-owned entity carries `storeId`.
model Store {
  id                         String      @id @default(cuid())
  name                       String
  /// Used for the platform subdomain: `<slug>.shopbd.com`.
  slug                       String      @unique
  status                     StoreStatus @default(DRAFT)
  description                String?
  logoUrl                    String?
  contactEmail               String?
  contactPhone               String?
  addressLine                String?
  district                   String?
  currency                   String      @default("BDT")
  timezone                   String      @default("Asia/Dhaka")
  /// Delivery charges in minor units (poisha). 6000 = ৳60.
  deliveryChargeInsideDhaka  Int         @default(6000)
  deliveryChargeOutsideDhaka Int         @default(12000)
  /// Next human-readable order number for this store (#1001, #1002…).
  nextOrderNumber            Int         @default(1001)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  members    StoreMember[]
  auditLogs  AuditLog[]
  theme      StoreTheme?
  categories Category[]
  products   Product[]
  carts      Cart[]
  customers  Customer[]
  orders     Order[]

  @@map("stores")
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

/// Per-store configuration of a ready-made theme. Missing row = theme defaults.
model StoreTheme {
  id           String   @id @default(cuid())
  storeId      String   @unique
  /// Key into the theme registry (src/themes).
  themeKey     String   @default("modern")
  primaryColor String?
  heroTitle    String?
  heroSubtitle String?
  heroImageUrl String?
  /// Optional announcement bar text, e.g. "Free delivery inside Dhaka".
  announcement String?
  footerText   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_themes")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, sortOrder])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String
  slug           String
  description    String?
  /// Minor units (poisha). 125000 = ৳1,250.
  price          Int
  /// Original price shown struck through, in minor units.
  compareAtPrice Int?
  stock          Int           @default(0)
  sku            String?
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images               ProductImage[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([storeId, categoryId])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  url        String
  /// Object key in file storage; null for images linked by URL.
  storageKey String?
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([storeId])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────────
// Cart (guest carts identified by an httpOnly cookie token)
// ─────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  storeId   String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([storeId])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────

/// Append-only log of every stock change. Product.stock is the running total.
model InventoryAdjustment {
  id         String          @id @default(cuid())
  storeId    String
  productId  String
  /// Positive adds stock, negative removes it.
  delta      Int
  /// Stock after this adjustment.
  stockAfter Int
  reason     InventoryReason
  note       String?
  orderId    String?
  actorId    String?
  createdAt  DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_adjustments")
}

// ─────────────────────────────────────────────────────────────
// Customers & orders
// ─────────────────────────────────────────────────────────────

/// A shopper of one store, identified by phone number within that store.
model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  /// Normalized to 01XXXXXXXXX.
  phone     String
  email     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@unique([storeId, phone])
  @@index([storeId, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String
  name        String
  phone       String
  district    String
  upazila     String
  area        String?
  addressLine String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model Order {
  id            String        @id @default(cuid())
  storeId       String
  /// Per-store sequence shown to merchants and customers (#1001).
  orderNumber   Int
  customerId    String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)

  // Amounts in minor units (poisha).
  subtotal       Int
  deliveryCharge Int
  discount       Int @default(0)
  total          Int

  // Shipping snapshot: kept as placed, even if the customer changes later.
  customerName String
  phone        String
  email        String?
  district     String
  upazila      String
  area         String?
  addressLine  String
  postalCode   String?
  customerNote String?
  /// Internal note, only visible to the store.
  merchantNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  events               OrderEvent[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  /// Null if the product was deleted later; the snapshot below remains.
  productId String?
  name      String
  sku       String?
  unitPrice Int
  quantity  Int
  lineTotal Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Status timeline for an order.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  /// Null for platform-level events.
  storeId    String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
