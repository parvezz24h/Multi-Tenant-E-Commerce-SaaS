generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

/// Platform-wide role. Store-level roles live on StoreMember.
enum PlatformRole {
  USER
  SUPER_ADMIN
}

/// Role of a user inside a single store (tenant).
enum StoreRole {
  STORE_OWNER
  STORE_ADMIN
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// Auth (managed by Better Auth)
// ─────────────────────────────────────────────────────────────

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships StoreMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────

/// A store is a tenant. Every tenant-owned entity carries `storeId`.
model Store {
  id                         String      @id @default(cuid())
  name                       String
  /// Used for the platform subdomain: `<slug>.shopbd.com`.
  slug                       String      @unique
  status                     StoreStatus @default(DRAFT)
  description                String?
  logoUrl                    String?
  contactEmail               String?
  contactPhone               String?
  addressLine                String?
  district                   String?
  currency                   String      @default("BDT")
  timezone                   String      @default("Asia/Dhaka")
  /// Delivery charges in minor units (poisha). 6000 = ৳60.
  deliveryChargeInsideDhaka  Int         @default(6000)
  deliveryChargeOutsideDhaka Int         @default(12000)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  members    StoreMember[]
  auditLogs  AuditLog[]
  theme      StoreTheme?
  categories Category[]
  products   Product[]
  carts      Cart[]

  @@map("stores")
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

/// Per-store configuration of a ready-made theme. Missing row = theme defaults.
model StoreTheme {
  id           String   @id @default(cuid())
  storeId      String   @unique
  /// Key into the theme registry (src/themes).
  themeKey     String   @default("modern")
  primaryColor String?
  heroTitle    String?
  heroSubtitle String?
  heroImageUrl String?
  /// Optional announcement bar text, e.g. "Free delivery inside Dhaka".
  announcement String?
  footerText   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_themes")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, sortOrder])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String
  slug           String
  description    String?
  /// Minor units (poisha). 125000 = ৳1,250.
  price          Int
  /// Original price shown struck through, in minor units.
  compareAtPrice Int?
  stock          Int           @default(0)
  sku            String?
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images    ProductImage[]
  cartItems CartItem[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([storeId, categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([storeId])
  @@map("product_images")
}

// ─────────────────────────────────────────────────────────────
// Cart (guest carts identified by an httpOnly cookie token)
// ─────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  storeId   String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([storeId])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  /// Null for platform-level events.
  storeId    String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
