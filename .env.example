# Database (docker compose: `docker compose up -d`)
DATABASE_URL="postgresql://shopbd:shopbd@localhost:5433/shopbd?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Platform
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="shopcreatorbd.vercel.app"

# File storage for product images: "local" (dev, files in ./.uploads) or "s3".
# Check an S3 setup with: pnpm storage:check
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""              # AWS region of the bucket, e.g. ap-southeast-1
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # optional for AWS (defaults to the bucket URL); set for CloudFront/CDN
S3_ENDPOINT=""            # only for S3-compatible services such as Cloudflare R2

# Custom domains. With a Vercel token + project id, merchant domains are added
# to the Vercel project (routing + automatic SSL). Without them, the app only
# checks DNS (fine for local development).
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""         # only if the project belongs to a team
# DNS targets shown to merchants (defaults are Vercel's).
DOMAIN_CNAME_TARGET="cname.vercel-dns.com"
DOMAIN_A_RECORD="76.76.21.21"

# Where merchants send subscription payments (shown on the billing page).
PLATFORM_BKASH_NUMBER=""   # e.g. 01XXXXXXXXX (personal/merchant)
PLATFORM_NAGAD_NUMBER=""
PLATFORM_BANK_DETAILS=""   # e.g. "ShopCreatorBD Ltd, A/C 123..., Dutch-Bangla Bank, Gulshan branch"
