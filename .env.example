# Database (docker compose: `docker compose up -d`)
DATABASE_URL="postgresql://shopbd:shopbd@localhost:5433/shopbd?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Platform
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="shopcreatorbd.vercel.app"

# File storage: "local" (dev, files in ./.uploads) or "s3" (S3 / Cloudflare R2)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # R2: https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # public base URL for the bucket, e.g. https://cdn.example.com
